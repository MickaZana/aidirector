# Copy this to .env.local and fill in real values. Never commit .env.local.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres (https://neon.tech) — use a branch DB for dev, main for prod
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/aidirector?sslmode=require

# ─── Queue ───────────────────────────────────────────────────────────────────
# Upstash Redis (https://upstash.com) — Redis URL with TLS
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ─── Object storage ──────────────────────────────────────────────────────────
# Cloudflare R2 (zero egress; create bucket "aidirector-prod")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aidirector-prod
R2_PUBLIC_BASE_URL=https://media.aidirector.app

# ─── Auth ────────────────────────────────────────────────────────────────────
# Clerk (https://clerk.com) — test instance keys for dev
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── Billing ─────────────────────────────────────────────────────────────────
# Stripe — test mode keys for dev
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe metered billing — Meter IDs created in Stripe dashboard
STRIPE_METER_ASR_MINUTES=mtr_xxx
STRIPE_METER_GPU_SECONDS=mtr_xxx
STRIPE_METER_EXPORT_COUNT=mtr_xxx

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPGRAM_API_KEY=

# ─── Workers ─────────────────────────────────────────────────────────────────
# Modal (https://modal.com) — token from `modal token new`
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOGFIRE_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
# Next.js public — these are exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# FastAPI
API_PORT=8000
API_BASE_URL=http://localhost:8000
ENV=development
